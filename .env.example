# ─── Database (Neon) ───────────────────────────────────────
# Conexão pooled (aplicação em runtime)
DATABASE_URL=
# Conexão direta (Prisma CLI para migrações)
DIRECT_URL=

# ─── Auth.js ──────────────────────────────────────────────
# Gerar com: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ─── Cloudflare R2 ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mindclinic-private
R2_ENDPOINT=

# ─── LiveKit ──────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# ─── Gemini ───────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Resend ───────────────────────────────────────────────
RESEND_API_KEY=

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Public (seguras para exposição no navegador) ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
