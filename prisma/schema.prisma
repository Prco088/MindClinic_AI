generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PSYCHOLOGIST
  PSYCHIATRIST
  THERAPIST
  SECRETARY
  PATIENT
}

enum ConsentCategory {
  DATA_PROCESSING
  DOCUMENT_STORAGE
  TELEMEDICINE
  AI_ASSISTANCE
  MARKETING
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  ONLINE
  HOME_VISIT
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum AiProvider {
  GEMINI
  OPENAI
  AZURE_OPENAI
}

enum AiAnalysisType {
  SESSION_SUMMARY
  PATIENT_SUMMARY
  DOCUMENT_SUMMARY
  CLINICAL_INSIGHT
  RISK_ANALYSIS
}

enum AiJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  patients              Patient[]
  appointments          Appointment[]
  medicalRecords        MedicalRecord[]
  consentTerms          ConsentTerm[]
  anamnesis             Anamnesis[]
  progressNotes         ProgressNote[]
  diagnoses             Diagnosis[]
  attachments           Attachment[]
  auditLogs             AuditLog[]
  progressNoteAddendums ProgressNoteAddendum[]
  consentVersions       ConsentVersion[]
  consentAcceptances    ConsentAcceptance[]
  workingHours          WorkingHours[]
  calendarBlocks        CalendarBlock[]
  appointmentReminders  AppointmentReminder[]
  googleConnections     GoogleCalendarConnection[]
  outlookConnections    OutlookCalendarConnection[]
  aiAnalyses            AiAnalysis[]
  aiJobs                AiJob[]
  aiPromptTemplates     AiPromptTemplate[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(PSYCHOLOGIST)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts                  Account[]
  sessions                  Session[]
  appointments              Appointment[]
  medicalRecords            MedicalRecord[]
  progressNotes             ProgressNote[]
  diagnoses                 Diagnosis[]
  auditLogs                 AuditLog[]
  progressNoteAddendums     ProgressNoteAddendum[]
  attachments               Attachment[]
  workingHours              WorkingHours[]
  calendarBlocks            CalendarBlock[]
  googleCalendarConnection  GoogleCalendarConnection?
  outlookCalendarConnection OutlookCalendarConnection?
  aiAnalyses                AiAnalysis[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Patient {
  id                    String    @id @default(cuid())
  fullName              String
  preferredName         String?
  birthDate             DateTime?
  gender                String?
  cpf                   String?
  rg                    String?
  phone                 String?
  email                 String?
  occupation            String?
  maritalStatus         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  healthInsurance       String?
  notes                 String?   @db.Text
  isActive              Boolean   @default(true)
  tenantId              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  consentTerms       ConsentTerm[]
  anamnesis          Anamnesis[]
  progressNotes      ProgressNote[]
  diagnoses          Diagnosis[]
  attachments        Attachment[]
  consentAcceptances ConsentAcceptance[]
  patientAccount     PatientAccount?
  auditLogs          AuditLog[]
  aiAnalyses         AiAnalysis[]
  aiJobs             AiJob[]

  @@unique([tenantId, cpf])
}

model PatientAccount {
  id           String    @id @default(cuid())
  patientId    String    @unique
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Appointment {
  id               String            @id @default(cuid())
  tenantId         String
  patientId        String
  professionalId   String
  title            String?
  description      String?           @db.Text
  location         String?
  appointmentType  AppointmentType   @default(IN_PERSON)
  status           AppointmentStatus @default(SCHEDULED)
  startsAt         DateTime
  endsAt           DateTime
  durationMinutes  Int
  notes            String?           @db.Text
  meetingUrl       String?
  externalEventId  String?
  externalProvider String?
  syncStatus       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professional User                  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  reminders    AppointmentReminder[]
}

model WorkingHours {
  id             String  @id @default(cuid())
  tenantId       String
  professionalId String
  weekday        Int // 0 = Sunday, 1 = Monday, etc.
  startTime      String // "08:00"
  endTime        String // "18:00"
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model CalendarBlock {
  id             String   @id @default(cuid())
  tenantId       String
  professionalId String
  title          String
  reason         String?
  startsAt       DateTime
  endsAt         DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model AppointmentReminder {
  id            String         @id @default(cuid())
  tenantId      String
  appointmentId String
  type          String // e.g., "EMAIL", "WHATSAPP", "SMS"
  status        ReminderStatus @default(PENDING)
  scheduledFor  DateTime
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id        String   @id @default(cuid())
  notes     String
  patientId String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentTerm {
  id        String  @id @default(cuid())
  accepted  Boolean @default(false)
  patientId String
  tenantId  String

  acceptedAt    DateTime?
  version       String?
  signatureType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Anamnesis {
  id        String @id @default(cuid())
  tenantId  String
  patientId String
  formData  Json

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model ProgressNote {
  id        String @id @default(cuid())
  tenantId  String
  patientId String
  userId    String

  sessionDate        DateTime
  content            String   @db.Text
  clinicalAssessment String?  @db.Text
  therapeuticPlan    String?  @db.Text
  observations       String?  @db.Text

  isSigned Boolean   @default(false)
  signedAt DateTime?
  signedBy String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient   Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  addendums ProgressNoteAddendum[]
}

model ProgressNoteAddendum {
  id             String @id @default(cuid())
  tenantId       String
  progressNoteId String
  userId         String
  content        String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  progressNote ProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Diagnosis {
  id        String @id @default(cuid())
  tenantId  String
  patientId String
  userId    String

  cidCode     String?
  system      String?
  title       String
  description String? @db.Text
  isActive    Boolean @default(true)

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String @id @default(cuid())
  tenantId  String
  patientId String

  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String

  uploadedBy String
  uploadedAt DateTime @default(now())
  scanStatus String?  @default("PENDING")

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  versions AttachmentVersion[]
}

model AttachmentVersion {
  id String @id @default(cuid())

  attachmentId String

  fileName   String
  storageKey String

  createdAt DateTime @default(now())

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String  @id @default(cuid())
  tenantId  String
  userId    String?
  patientId String?

  entity   String
  entityId String
  action   String

  oldData Json?
  newData Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model ConsentVersion {
  id          String          @id @default(cuid())
  tenantId    String
  title       String
  description String          @db.Text
  version     String
  category    ConsentCategory
  isActive    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acceptances ConsentAcceptance[]
}

model ConsentAcceptance {
  id               String @id @default(cuid())
  tenantId         String
  patientId        String
  consentVersionId String

  acceptedAt        DateTime @default(now())
  acceptedIp        String?
  acceptedUserAgent String?
  acceptedBy        String?

  revokedAt DateTime?
  revokedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentVersion ConsentVersion @relation(fields: [consentVersionId], references: [id], onDelete: Cascade)
}

model GoogleCalendarConnection {
  id                 String    @id @default(cuid())
  tenantId           String
  professionalId     String
  googleAccountEmail String
  accessToken        String    @db.Text
  refreshToken       String?   @db.Text
  expiresAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User   @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId])
}

model OutlookCalendarConnection {
  id             String    @id @default(cuid())
  tenantId       String
  professionalId String
  email          String
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional User   @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId])
}

model AiAnalysis {
  id           String         @id @default(cuid())
  tenantId     String
  patientId    String?
  createdBy    String
  type         AiAnalysisType
  status       AiJobStatus
  title        String
  summary      String?        @db.Text
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  model        String
  provider     AiProvider
  result       String?        @db.Text
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  jobs    AiJob[]
}

model AiJob {
  id          String      @id @default(cuid())
  tenantId    String
  patientId   String?
  analysisId  String
  jobType     String
  status      AiJobStatus @default(PENDING)
  queuedAt    DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  error       String?     @db.Text

  createdAt DateTime @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  analysis AiAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model AiPromptTemplate {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  description    String? @db.Text
  promptTemplate String  @db.Text
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
