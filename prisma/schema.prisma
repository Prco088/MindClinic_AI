generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PSYCHOLOGIST
  PSYCHIATRIST
  THERAPIST
  SECRETARY
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  patients       Patient[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  consentTerms   ConsentTerm[]
  anamnesis      Anamnesis[]
  progressNotes  ProgressNote[]
  diagnoses      Diagnosis[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(PSYCHOLOGIST)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts       Account[]
  sessions       Session[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  progressNotes  ProgressNote[]
  diagnoses      Diagnosis[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Patient {
  id                    String    @id @default(cuid())
  fullName              String
  preferredName         String?
  birthDate             DateTime?
  gender                String?
  cpf                   String?
  rg                    String?
  phone                 String?
  email                 String?
  occupation            String?
  maritalStatus         String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?   @db.Text
  isActive              Boolean   @default(true)
  tenantId              String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  consentTerms   ConsentTerm[]
  anamnesis      Anamnesis[]
  progressNotes  ProgressNote[]
  diagnoses      Diagnosis[]
  attachments    Attachment[]

  @@unique([tenantId, cpf])
}

model Appointment {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELED
  patientId String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MedicalRecord {
  id        String   @id @default(cuid())
  notes     String
  patientId String
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentTerm {
  id            String   @id @default(cuid())
  accepted      Boolean  @default(false)
  patientId     String
  tenantId      String
  
  acceptedAt    DateTime?
  version       String?
  signatureType String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Anamnesis {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String
  formData  Json
  
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model ProgressNote {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  userId      String
  
  sessionDate DateTime
  content     String   @db.Text
  isSigned    Boolean  @default(false)
  signedAt    DateTime?

  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Diagnosis {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String
  userId      String

  cidCode     String?
  title       String
  description String?  @db.Text
  isActive    Boolean  @default(true)

  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  patientId   String

  fileName    String
  fileType    String
  fileSize    Int
  storageKey  String

  deletedAt   DateTime?
  deletedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String

  entity    String
  entityId  String
  action    String

  oldData   Json?
  newData   Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
